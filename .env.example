# Conexão com o Supabase — COPIE este arquivo para ".env" e preencha.
# Onde achar: painel do Supabase → Project Settings → API

# URL do projeto (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave pública "anon" (pode ir no frontend; a RLS protege os dados)
SUPABASE_ANON_KEY=

# (OPCIONAL) Chave "service_role" — SECRETA, ignora a RLS.
# Só para a verificação profunda e o script de migração. NUNCA vai no frontend.
SUPABASE_SERVICE_ROLE=

# (OPCIONAL) Credenciais do admin de teste — só para a prova de RLS (verificar-login.mjs).
# Ficam apenas neste arquivo local (ignorado pelo git).
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# (MIGRAÇÃO) Fonte dos dados da planilha — use UMA das duas (migrar.mjs).
#  a) CSV exportado da aba Respostas (Arquivo → Download → CSV):
MIGRACAO_CSV=
#  b) OU a URL do Apps Script atual (endpoint ?action=dados):
MIGRACAO_APPS_SCRIPT_URL=
